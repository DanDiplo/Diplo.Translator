<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Product>Diplo.Translator</Product>
    <PackageId>Diplo.Translator</PackageId>
    <Title>Diplo Translator for Umbraco</Title>
    <VersionPrefix>17.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <Description>Umbraco 17 package that uses Umbraco.AI to translate Dictionary items.</Description>
    <PackageTags>umbraco plugin package translation dictionary translator ai umbraco-marketplace</PackageTags>
    <Company>DanDiplo</Company>
    <Copyright>Dan 'Diplo' Booth</Copyright>
    <PackageProjectUrl>https://github.com/DanDiplo/Diplo.Translator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DanDiplo/Diplo.Translator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>v17</RepositoryBranch>
    <PackageReleaseNotes>Umbraco 17 / .NET 10 rewrite. Translation now uses Umbraco.AI.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <Authors>DanDiplo</Authors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <CompressionEnabled>false</CompressionEnabled>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.AI" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Client\**" />
    <Content Remove="Client\**" />
    <None Remove="Client\**" />
    <EmbeddedResource Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="Client\vite.config.ts" Pack="false" />
    <None Include="Client\tsconfig.json" Pack="false" />
    <None Include="Client\package.json" Pack="false" />
    <None Include="Client\src\**\*" Pack="false" />
    <None Include="..\Images\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="NuGet.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="RestoreClientPackages" BeforeTargets="BuildClient" Condition="!Exists('$(MSBuildProjectDirectory)\Client\node_modules')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

  <Target Name="BuildClientForPack" BeforeTargets="Pack">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm ci" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\Client" Command="npm run build" />
  </Target>

</Project>
