    <PackageVersion Include="Umbraco.Cms.Core" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.3.5" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="17.3.5" />
    <PackageVersion Include="Umbraco.AI" Version="1.10.1" />
  </ItemGroup>
</Project>
